{
  "$schema": "http://json.schemastore.org/appsettings.json",
  "ConnectionStrings": {
    "Default": "Server=YOUR_SQL_SERVER_HERE;Database=YOUR_DATABASE_NAME;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "https://api.YOUR_COMPANY_DOMAIN.com",
    "Audience": "YOUR_API_CLIENT_NAME",
    "SigningKey": "SET_THIS_VIA_USER_SECRETS_MIN_32_CHARS",
    "AccessTokenMinutes": 15,
    "OnboardingTokenMinutes": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "https://YOUR_FRONTEND_DOMAIN.com",
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "PerUser": {
      "Search": 150,
      "Auth": 10
    },
    "PerTenant": {
      "SearchBasePerUser": 150,
      "SearchMaxCap": 1000,
      "FetchXml": 60,
      "Auth": 20
    },
    "PerIP": {
      "OnboardingToken": 5,
      "ClientErrorLog": 10,
      "PasswordReset": 5,
      "FirstAdminSetup": 5
    },
    "General": {
      "Window": "1m",
      "EnableLogging": true
    }
  },
  "AppSettings": {
    "FrontendUrl": "https://YOUR_FRONTEND_DOMAIN.com"
  },
  "SendGrid": {
    "ApiKey": "SET_THIS_VIA_USER_SECRETS",
    "FromEmail": "noreply@YOUR_COMPANY_DOMAIN.com",
    "FromName": "Financia",
    "InvitationTemplateId": "d-YOUR_INVITATION_TEMPLATE_ID",
    "PasswordResetTemplateId": "d-YOUR_PASSWORD_RESET_TEMPLATE_ID",
    "EmailVerificationTemplateId": "d-YOUR_EMAIL_VERIFICATION_TEMPLATE_ID"
  },
  "ForwardedHeaders": {
    "TrustedHops": 2
  },
  "Onboarding": {
    "RecaptchaMinScore": 0.5
  },
  "Setup": {
    "BootstrapKey": ""
  },
  "PasswordReset": {
    "RecaptchaMinScore": 0.5,
    "PerEmailLimit": 3,
    "PerEmailWindowMinutes": 15,
    "QueueCapacity": 100
  },
  "EmailVerification": {
    "PerUserLimit": 3,
    "PerUserWindowMinutes": 15,
    "QueueCapacity": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Storage": {
    // Absolute base directory for uploaded documents. Leave empty to resolve to
    // %HOME%\financia-uploads on Azure App Service (persistent, instance-shared),
    // else a local temp path in development.
    "DocumentsPath": ""
  },
  "AllowedHosts": "*"
}
