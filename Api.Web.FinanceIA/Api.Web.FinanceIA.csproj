<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aee6fff7-a73a-41a0-b23a-26c99e4999b2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
    <PackageReference Include="Google.Cloud.Firestore" Version="3.10.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.25" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.AzureAppServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.3" />
    <PackageReference Include="itext7" Version="8.0.5" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="itext7.bouncy-castle-adapter" Version="8.0.5" />
    <PackageReference Include="PDFtoImage" Version="4.0.0" />
    <!-- Excel (.xlsx) reading for the chat attachment parser. ClosedXML (MIT) is pure managed —
         no Excel install and no COM interop, so it runs as-is on the Azure App Service.
         DocumentFormat.OpenXml (MIT) already arrives transitively via ClosedXML, but the parser
         calls it directly to reject macro-enabled workbooks by SpreadsheetDocumentType, so it is
         declared explicitly. Versions are pinned exactly, as everywhere else here. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <PackageReference Include="SendGrid" Version="9.28.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals to the test project so pure helpers (e.g. BuildLufeSourceRef)
         can be unit-tested directly. -->
    <InternalsVisibleTo Include="Api.Web.FinanceIA.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand faces embedded by PdfExportService (Sora / DM Sans / JetBrains Mono, all OFL).
         Copied to the output/publish directory so the running App Service (Windows) can load them
         from AppContext.BaseDirectory. A missing/failed font never fails an export — the service
         falls back to the standard-14 Helvetica pair. The .ttf files are default-globbed as None by
         the SDK, so we Update (not Include) to add the copy metadata without duplicating the item. -->
    <None Update="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Clases\Exceptions\" />
    <Folder Include="Claude\hooks\" />
    <Folder Include="Claude\commands\" />
    <Folder Include="Claude\skills\" />
    <Folder Include="Data\Configurations\" />
    <Folder Include="Data\Repositories\" />
    <Folder Include="docs\guides\" />
    <Folder Include="docs\decisions\" />
    <Folder Include="Servicios\" />
  </ItemGroup>

</Project>
