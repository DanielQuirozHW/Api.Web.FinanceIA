{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // What reaches Application Insights (the OpenTelemetry logging provider; only when
    // APPLICATIONINSIGHTS_CONNECTION_STRING is set). Override per category with an App Setting,
    // e.g. Logging__OpenTelemetry__LogLevel__Api.Web.FinanceIA = Debug. See docs/guides/telemetry.md.
    "OpenTelemetry": {
      "LogLevel": {
        "Default": "Warning",
        "Api.Web.FinanceIA": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Anthropic": {
    "ExtractionConfidenceFallbackThreshold": 0.60,
    // Balance extraction model (optional, App Service settings): Anthropic:ExtractionModel (default
    // claude-sonnet-4-6), Anthropic:ExtractionEffort, Anthropic:ExtractionTimeoutSeconds. Left unset
    // here on purpose: unset sends exactly today's request. See docs/guides/extraction-model.md.
    // Model for the legajo document classification (M10 Phase 2a). The API key stays in
    // user-secrets / App Service settings (Anthropic:ApiKey), never here.
    "LegajoClassificationModel": "claude-haiku-4-5"
  },
  // Legajo document pipeline (M10 Phase 2a). See Models/LegajoOptions.cs.
  "Legajo": {
    "WorkerConcurrency": 1,
    "StaleMinutes": 10,
    "ClassificationConfidenceThreshold": 0.7
  },
  // POST /api/analyses with "Prefer: respond-async" → 202 + background run. See Models/AnalysisOptions.cs.
  // Requests without the header are unaffected. StaleProcessingMinutes must exceed the worst-case
  // run if more than one App Service instance ever runs: ~21 min at the 120 s extraction timeout,
  // ~79 min at Anthropic:ExtractionTimeoutSeconds=480 (docs/guides/extraction-model.md has the table).
  "Analysis": {
    "MaxConcurrentJobs": 2,
    "QueueCapacity": 100,
    "MaxQueuedPerTenant": 5,
    "StaleProcessingMinutes": 20,
    "StaleSweepMinutes": 5
  },
  // POST /api/analyses/{id}/rescore ("Reanalizar con datos actualizados"). See Models/RescoreOptions.cs.
  "Rescore": {
    "CooldownSeconds": 120,
    "BcraRetryAfterSeconds": 60
  },
  // Billing quota enforcement. The analysis limit always blocks; the two switches below govern the
  // two chat limits, both of which ship measured-but-not-blocking until product agrees the per-plan
  // figures in BillingPlans.cs. See Models/BillingOptions.cs.
  "Billing": {
    "EnforceChatTokens": false,
    // The per-CONVERSATION context ceiling, a different kind of limit from the monthly pool above:
    // it never resets, and the only thing that clears it is the analyst starting a new conversation.
    // Off until the 40k/60k/80k budgets are agreed; while off the gate still measures and logs.
    "EnforceChatContextBudget": false,
    // Failed extraction attempts a single balance FILE may cost before POST /api/analyses stops
    // running another one. A failed extraction never consumes a monthly análisis, so this is what
    // bounds the Claude spend on an unreadable document. 0 or negative disables the guard.
    "MaxExtractionAttemptsPerDocument": 2
  },
  "Storage": {
    "DocumentsPath": ""
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "https://api.financeia.com",
    "Audience": "fnanceia-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "OnboardingTokenMinutes": 10
  },
  "RateLimiting": {
    "PerUser": {
      "Search": 150,
      "Auth": 30,
      "MfaBackupCodeValidate": 5,
      "MfaBackupCodeGenerate": 5,
      "MfaBackupCodeRemaining": 30
    },
    "PerTenant": {
      "SearchBasePerUser": 150,
      "SearchMaxCap": 1000,
      "FetchXml": 60,
      "Auth": 100
    },
    "PerIP": {
      "OnboardingToken": 5,
      "ClientErrorLog": 10,
      "MfaBackupCodeValidate": 20,
      "MfaBackupCodeRedeem": 10,
      "PasswordReset": 5,
      "FirstAdminSetup": 5
    },
    "General": {
      "Window": "1m",
      "EnableLogging": true
    }
  },
  "AppSettings": {
    //"FrontendUrl": "http://localhost:3000"
    "FrontendUrl": "https://financia-portal.vercel.app"
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "jlnasif@hwapplications.com",
    "FromName": "FinancIA",
    "InvitationTemplateId": "d-5f0dd166b22c41d98278e6ac28711be2",
    // Global default for the password-reset email. Empty = not deployed yet: requests still answer
    // 202 but no email is sent (Error logged). Per-tenant override: TenantSettings
    // email.password_reset.template_id. Source HTML: docs/email-templates/password-reset.es-AR.html
    "PasswordResetTemplateId": "",
    // Global default for the email-verification email. Empty = not deployed yet: requests still
    // answer 202 but nothing is sent (Outcome=TemplateMissing). Per-tenant override: TenantSettings
    // email.email_verification.template_id. Source HTML: docs/email-templates/verify-email.es-AR.html
    "EmailVerificationTemplateId": ""
  },
  "ForwardedHeaders": {
    // Forwarding hops trusted from the right of X-Forwarded-For: 2 = Vercel + App Service
    // front end. 1 only if the API is served without Vercel in front. See ClientIpForwarding.
    "TrustedHops": 2
  },
  "Onboarding": {
