{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "https://api.serviciosfinancieros.com",
    "Audience": "serviciosfinancieros-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "OnboardingTokenMinutes": 10
  },
  "RateLimiting": {
    "PerUser": {
      "Search": 150,
      "Auth": 10
    },
    "PerTenant": {
      "SearchBasePerUser": 150,
      "SearchMaxCap": 1000,
      "FetchXml": 60,
      "Auth": 20
    },
    "PerIP": {
      "OnboardingToken": 5
    },
    "General": {
      "Window": "1m",
      "EnableLogging": true
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://portal.serviciosfinancieros.com"
    ]
  }
}
