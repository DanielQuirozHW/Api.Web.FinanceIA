<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- EF Core in-memory provider (version matches the main project's EF Core) so the
         repository query behaviour — the status WHERE clauses and ordering — can be exercised
         against a real DbContext. A database provider, not a mocking library. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.14" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Already reachable transitively via the ProjectReference below; declared
         explicitly because PdfAttachmentExtractorTests builds its PDF fixtures with
         iText7 and reads them back with PdfPig. Versions match the main project. -->
    <PackageReference Include="itext7" Version="8.0.5" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <!-- Already reachable transitively via the ProjectReference above; declared explicitly
         because ExcelCashFlowParserTests builds its .xlsx fixtures in-process with ClosedXML
         and its macro-enabled and .docx fixtures with the OpenXml SDK, so no binary test files
         are committed. Versions match the main project. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Synthetic encrypted CPCE wrappers (no client data). Generated by make_fixtures.py and
         committed; see Fixtures/EncryptedOblea/README.md. Copied next to the test assembly so
         the tests read them from AppContext.BaseDirectory. Update, not Include: the SDK's default
         None glob already holds every file here, and the .py and .md stay Build Action None,
         never compiled (MISTAKES [001]). -->
    <None Update="Fixtures\**\*.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Api.Web.FinanceIA/Api.Web.FinanceIA.csproj" />
    <!-- Needed so the authorization tests can reference controller types (derive from
         ControllerBase) and read [Authorize(Roles=...)] metadata. The shared framework
         reference does not flow transitively from the Web project's ProjectReference. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
